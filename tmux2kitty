set -u
umask 0077

# ============================================================
# COMMAND LINE ARGUMENTS
# ============================================================

usage() {
    echo "Usage: $0 <remote|local> [-t 'session name']"
    echo
    echo "Arguments:"
    echo "  <remote|local>       Remote SSH host, or 'local'"
    echo "  -t 'session name'    Optional tmux session name"
    echo
    echo "Examples:"
    echo "  $0 user@server"
    echo "  $0 user@server -t mysession"
    echo "  $0 local"
    echo "  $0 local -t mysession"
}

SESSION=""
RUNTIME_DIR="${XDG_RUNTIME_DIR:-$HOME/.cache/tmux-kitty}"

# Exactly 1 argument: remote/local, prompt for session
# Exactly 3 arguments: remote/local -t session, don't prompt

if [[ $# -eq 1 ]]; then
    REMOTE="$1"
    SESSION=""
elif [[ $# -eq 3 ]]; then
    REMOTE="$1"

    if [[ "$2" != "-t" || -z "$3" ]]; then
        usage
        exit 1
    fi

    SESSION="$3"
    if [[ ! "$SESSION" =~ ^[A-Za-z0-9_.-]{1,32}+$ ]]; then
	echo "Invalid session name. Allowed characters: letters, numbers, underscores, dots, and hyphens. Maximum length is 32 bytes." >&2
	exit 1
    fi

else
    usage
    exit 1
fi




if [[ "$REMOTE" == "local" ]]; then
    LOCAL=1
else
    LOCAL=0
fi


create_runtime_dir()
{
	local runtime_dir="$1"
	# Per-session runtime directory
	if ! mkdir -p -- "$runtime_dir"; then
	    echo "ERROR: Failed to create runtime directory: $runtime_dir" >&2
	    exit 1
	fi
	chmod 700 -- "$runtime_dir"
}


KITTY_SOCKET=""
WORKDIR=""

# SSH multiplexing socket
SSH_CONTROL="$HOME/.ssh/control-%C"

RECONNECT_DELAY=2
POLL_INTERVAL=1


# ============================================================
# SSH OPTIONS
# ============================================================

SSH_OPTS=(
    -o ControlMaster=auto
    -o ControlPath="$SSH_CONTROL"
    -o ControlPersist=10m
    -o ServerAliveInterval=10
    -o ServerAliveCountMax=3
    -o ConnectTimeout=10
)


# ============================================================
# TRAP CLEANUP
# ============================================================

cleanup() {
    [[ -n "${SESSION_DIR:-}" ]] && rm -rf -- "$SESSION_DIR"
}
trap cleanup EXIT


# ============================================================
# SSH CONTROL CHANNEL FUNCTIONS
# ============================================================

ssh_master_alive()
{
    [ "${LOCAL:-0}" -eq 1 ] && return 0
    ssh "${SSH_OPTS[@]}" -O check "$REMOTE"  >/dev/null 2>&1
}

check_ssh_socket()
{
	[ "${LOCAL:-0}" -eq 1 ] && return 0

	SSH_HOST="$1"
	SOCKET_PATH=$(ssh ${SSH_OPTS[@]} -G "$SSH_HOST" | awk '/^controlpath / {print $2}')

	# Check if the file exists AND the connection test fails
	if [ -S "$SOCKET_PATH" ] && ! ssh "${SSH_OPTS[@]}" -O check "$SSH_HOST" 2>/dev/null; then
	    echo "⚠️ Stale SSH session detected! Fixing..."
	    rm -f -- "$SOCKET_PATH"
	fi

}

start_ssh_master()
{
    [ "${LOCAL:-0}" -eq 1 ] && return 0

    echo "Connecting to $REMOTE..."

    # Is there already a working master?
    if ssh_master_alive; then
        echo "SSH master already connected."
        return 0
    fi

    # There may be a stale control socket.
    check_ssh_socket "$REMOTE"

    # No usable master: create one.
    if ssh "${SSH_OPTS[@]}" -MNf "$REMOTE"; then
        echo "SSH master connected."
        return 0
    fi

    echo "ERROR: unable to establish SSH master."
    return 1
}

init_ssh_control()
{
    if ssh_master_alive; then
        return 0
    fi

    while ! start_ssh_master; do
        echo "Retrying SSH in ${RECONNECT_DELAY}s..."
        sleep "$RECONNECT_DELAY"
    done
}

ssh_remote()
{
    if [ "${LOCAL:-0}" -eq 1 ]; then
	eval "$1"
    else
        ssh "${SSH_OPTS[@]}" "$REMOTE" -- "$1"
    fi
}


# ============================================================
# SESSION SELECTION MENU
# ============================================================

tmux_all_session_list()
{
    local remote="$1"
    echo "=========================================="
    echo " TMUX REMOTE GUI LAUNCHER"
    echo "=========================================="
    
    echo "Active remote sessions on $REMOTE:"
    if ! ssh_remote "tmux ls" >/dev/null 2>&1; then
        echo "  (No active tmux sessions found)"
    else
        ssh_remote "tmux list-sessions -F '#{session_name}'" | grep -v '__' | while read -r s; do
            echo "  📦 Session: $s"
            ssh_remote "tmux list-windows -t '$s' -F '     ↳ Index #{window_index}: #{window_name}'" 2>/dev/null
        done
    fi
    echo "------------------------------------------"
}

input_session_name()
{
    local -n session="$1"
    local base_name="tmux-kitty"
    local default_session="${base_name}"
    local input_session
    

	while true; do
	    if [[ -z "$session" ]]; then
		read -p "Enter session name to connect or create [$default_session]: " input_session
		session="${input_session:-$default_session}"
	    else
		echo "Using session: $session"
	    fi

	    if [[ "$session" =~ ^[A-Za-z0-9_.-]{1,32}+$ ]]; then
		break
	    fi

	    echo "Invalid session name. Allowed characters: letters, numbers, underscores, dots, and hyphens. Maximum length is 32 bytes." >&2
	    session=""
	done


}
	    
tmux_select_or_create_session()
{
    local session="$1"
    if ! ssh_remote "tmux has-session -t '=${session}'" >/dev/null 2>&1; then
        echo "Session '$session' does not exist. Creating it now..."
        ssh_remote "tmux new-session -d -s '${session}'"
        sleep 1
    else
        echo "Connecting to existing session: $session"
    fi
    echo
}


# ============================================================
# KITTY CONNECTION FUNCTIONS
# ============================================================

init_kitty()
{
    local kitty_socket="$1"
    local -n ref_kitty_pid="$2"
    rm -f -- "$kitty_socket"

    echo "Starting Kitty terminal..."
    kitty \
        -o allow_remote_control=yes \
        -o remember_window_size=no \
        -o initial_window_width=100c \
        -o initial_window_height=24c \
        -o scrollback_pager="less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER" \
        -o mouse_map="wheel_up ungrabbed scroll_line_up" \
        -o mouse_map="wheel_down ungrabbed scroll_line_down" \
        -o tab_title_template="{title}" \
        -o dynamic_title=yes \
        --listen-on "unix:${kitty_socket}" &

    local kitty_pid=$!
    ref_kitty_pid=$kitty_pid

    for _ in {1..100}; do
        if [[ -S "$kitty_socket" ]]; then
            ref_kitty_pid=$kitty_pid
            return 0
        fi
        sleep 0.1
    done

    echo "ERROR: kitty socket did not appear."
    return 1
}

kitty_cmd()
{
    local kitty_socket="$KITTY_SOCKET"
    kitty @ \
        --to "unix:${kitty_socket}" \
        "$@"
}

kitty_create_tab()
{
    local index="$1"
    local name="$2"
    local runner="$3"
    local remote="$4"
    local session="$5"
    local window_id="$6"

                    kitty_cmd launch \
                        --type=tab \
                        --tab-title "$index-$name" \
                        --title "$index-$name" \
                        bash -c "printf '\033]2;%s\007' '$index'; exec '$runner' '$remote' '$session' '$window_id'" \
                        >/dev/null

                    KNOWN_WINDOWS[$WINDOW_ID]=1
                    sleep 0.8  # Allow tab to initialize fully

}

kitty_sync_tab_title()
{
    local window_ref="$1"
    local index="$2"
    local name="$3"
    
    # Remove leading '@' if it exists (e.g., turn "@0" into "0")
    CLEAN_REF="${window_ref#@}"

    # 1. Determine the expected title
    if [ -n "$NAME" ]; then
        EXPECTED_TITLE="${index}-${name}"
    else
        EXPECTED_TITLE="${index}"
    fi

    # 2. Find the actual Kitty Tab ID by searching for the reference in the cmdline
    # This checks if any command-line argument matches the reference (with or without '@')
    TAB_ID=$(kitty_cmd ls | jq -r --arg ref "$window_ref" --arg clean_ref "$CLEAN_REF" '
        .[].tabs[] 
        | select(.windows[].cmdline[]? | . == $ref or . == "@" + $clean_ref) 
        | .id
    ' | head -n 1)

    # 3. If a valid Tab ID was found, check and update its title
    if [ -n "$TAB_ID" ]; then
        CURRENT_TITLE=$(kitty_cmd ls | jq -r --arg id "$TAB_ID" '.[].tabs[] | select(.id|tostring == $id) | .title // empty')

        if [ "$CURRENT_TITLE" != "$EXPECTED_TITLE" ]; then
            kitty_cmd set-tab-title --match "id:$TAB_ID" "$EXPECTED_TITLE"
            kitty_cmd set-window-title --match "id:$TAB_ID" "$EXPECTED_TITLE"
        fi
    fi
}

kitty_sort_tab()
{
   local kitty_socket="$1"

   python3 -c '
import sys, json, subprocess, re

socket_path = sys.argv[1]
for _ in range(3): # Retry a couple times to ensure the new tab is fully registered in ls output
    res = subprocess.run(["kitty", "@", "--to", f"unix:{socket_path}", "ls"], capture_output=True, text=True)
    if res.returncode != 0:
        break
    try:
        data = json.loads(res.stdout)
        tabs = data[0].get("tabs", [])
        tab_tuples = []
        for tab in tabs:
            title = str(tab.get("title", "")).strip()
            tab_id = str(tab.get("id"))
            
            # Match either XXX or XXX-name (digits at the start, optional hyphen + text)
            match = re.match(r"^(\d+)(?:-.*)?$", title)
            if match:
                tab_num = int(match.group(1))
                tab_tuples.append((tab_num, tab_id))
        
        if tab_tuples:
            sorted_tuples = sorted(tab_tuples, key=lambda x: x[0])
            titles = [t[0] for t in tab_tuples]
            if titles != sorted(titles):
                for target_idx, (val, tid) in enumerate(sorted_tuples):
                    curr_res = subprocess.run(["kitty", "@", "--to", f"unix:{socket_path}", "ls"], capture_output=True, text=True)
                    if curr_res.returncode != 0:
                        break
                    curr_tabs = json.loads(curr_res.stdout)[0].get("tabs", [])
                    
                    # Apply the same flexible regex check to current tabs iteration
                    curr_tuples = []
                    for t in curr_tabs:
                        t_title = str(t.get("title", "")).strip()
                        t_match = re.match(r"^(\d+)(?:-.*)?$", t_title)
                        if t_match:
                            curr_tuples.append((int(t_match.group(1)), str(t.get("id"))))
                    
                    try:
                        curr_idx = [t[1] for t in curr_tuples].index(tid)
                    except ValueError:
                        continue
                    if curr_idx != target_idx:
                        subprocess.run(["kitty", "@", "--to", f"unix:{socket_path}", "focus-tab", "--match", f"id:{tid}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        diff = target_idx - curr_idx
                        action_cmd = "move_tab_forward" if diff > 0 else "move_tab_backward"
                        for _ in range(abs(diff)):
                            subprocess.run(["kitty", "@", "--to", f"unix:{socket_path}", "action", action_cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        break
        break
    except Exception:
        pass
' "$kitty_socket" 2>/dev/null
}

create_runner()
{
    local runner="$1"
    cat > "$runner" <<'EOF'
#!/usr/bin/env bash
set -u

if [[ "$1" == "local" ]]; then
    LOCAL=1
else
    LOCAL=0
fi

REMOTE="$1"
SESSION="$2"
WINDOW_ID="$3"

SSH_CONTROL="$HOME/.ssh/control-%C"
RECONNECT_DELAY=2

SSH_OPTS=(
    -o ControlMaster=auto
    -o ControlPath="$SSH_CONTROL"
    -o ControlPersist=10m
    -o ServerAliveInterval=10
    -o ServerAliveCountMax=3
    -o ConnectTimeout=10
)

ssh_remote()
{
    if [ "${LOCAL:-0}" -eq 1 ]; then
	eval "$1"
    else
        ssh "${SSH_OPTS[@]}" "$REMOTE" -- "$1"
    fi
}

ssh_master_alive()
{
[ "${LOCAL:-0}" -eq 1 ] && return 0
    ssh "${SSH_OPTS[@]}" -O check "$REMOTE" >/dev/null 2>&1
}

SAFE_WID=$(echo "$WINDOW_ID" | tr '@%' '_')
TAB_SESSION="${SESSION}__${SAFE_WID}"

cleanup_tab() {
    if [[ -n "${KITTY_WINDOW_ID:-}" && -n "${KITTY_SOCKET:-}" ]]; then
        kitty @ --to "unix:${KITTY_SOCKET}" close-tab --match "id:${KITTY_WINDOW_ID}" 2>/dev/null || true
    fi
}
trap cleanup_tab EXIT

while true; do
    while ! ssh_master_alive; do
        sleep "$RECONNECT_DELAY"
    done

    # Ensure an isolated session exists, link the window, disable mouse/alternate-screen, and set term-overrides
	ssh_remote "
	if ! tmux has-session -t '=${TAB_SESSION}' 2>/dev/null; then
            tmux new-session -d -s '${TAB_SESSION}'
            tmux link-window -s '${SESSION}:${WINDOW_ID}' -t '${TAB_SESSION}:' 2>/dev/null || true
            tmux kill-window -t '${TAB_SESSION}:0' 2>/dev/null || true
            tmux set-option -t '${TAB_SESSION}' mouse off
            tmux set-option -t '${TAB_SESSION}' alternate-screen off
            tmux set-option status off
            tmux set-option -ga terminal-overrides ',xterm*:smcup@:rmcup@'
        fi" > /dev/null 2>&1

	SSH_OPTS+=(-t)
	ssh_remote "TERM=xterm-256color tmux attach-session -t '${TAB_SESSION}'"
	unset 'SSH_OPTS[-1]'
	RET=$?
	if [[ $RET -eq 0 ]]; then
		exit 0
	fi

    sleep "$RECONNECT_DELAY"
done
EOF

    chmod +x "$runner"
}

tmux_purge_stale()
{
    local session="$1"
    ssh_remote "tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^${session}__' | xargs -r -I {} tmux kill-session -t '{}'" || true
}

tmux_window_to_session()
{
        local session="$1"
        ssh_remote "
            for s in \$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^${session}__'); do
                for wid in \$(tmux list-windows -t \"\$s\" -F '#{window_id}' 2>/dev/null); do
                    if ! tmux list-windows -t '=${session}' -F '#{window_id}' 2>/dev/null | grep -q \"\$wid\"; then
                        tmux move-window -s \"\$s:\$wid\" -t '=${session}:' 2>/dev/null || true
                    fi
                done
            done
        " >/dev/null 2>&1
}

tmux_window_list() {
	local session="$1"
	local window_list_command="tmux list-windows -t '=${session}' -F '#{window_id}|#{window_index}|#{window_name}'"
	ssh_remote "$window_list_command" 2>/dev/null
}
        
# ============================================================
# MAIN EXECUTION FLOW
# ============================================================

main()
{
    # Before starting, create runtime directory
    create_runtime_dir $RUNTIME_DIR

    # 1. Initialize SSH multiplexing control channel first
    init_ssh_control

    # 2. Present startup session menu
    tmux_all_session_list $REMOTE
    # $SESSION update by reference
    input_session_name "SESSION"

    SESSION_DIR="$RUNTIME_DIR/$SESSION"
    WORKDIR="$SESSION_DIR/work"

    mkdir -p  -- "$SESSION_DIR"
    rm    -rf -- "$WORKDIR"
    mkdir -p  -- "$WORKDIR"
    chmod 700 -- "$SESSION_DIR" "$WORKDIR"

    KITTY_SOCKET="$SESSION_DIR/kitty.sock"

    tmux_select_or_create_session $SESSION

    # 3. Purge stale remote tab sessions from previous runs for this session safely
    echo "Purging stale remote tab sessions..."
    tmux_purge_stale $SESSION 

    # 4. Initialize local Kitty terminal instance
    # $KITTY_PID update by reference
    init_kitty $KITTY_SOCKET "KITTY_PID" || exit 1

    # 5. Create tab runner script
    RUNNER="$WORKDIR/remote-tmux-tab.sh"
    create_runner $RUNNER


    declare -A KNOWN_WINDOWS

    echo
    echo "=========================================="
    echo " Remote tmux GUI started (Native Scrolling)"
    echo "=========================================="
    echo "Remote : $REMOTE"
    echo "Session: $SESSION"
    echo "Kitty  : $KITTY_PID"
    echo

    # 6. Continuous monitoring loop
    while true; do
        tmux_window_to_session $SESSION

        if mapfile -t WINDOWS < <(tmux_window_list $SESSION); then
            declare -A CURRENT_ACTIVE_IDS
            for ENTRY in "${WINDOWS[@]}"; do
                IFS='|' read -r WINDOW_ID INDEX NAME <<< "$ENTRY"
                CURRENT_ACTIVE_IDS[$WINDOW_ID]=1

		kitty_sync_tab_title $WINDOW_ID $INDEX $NAME

                if [[ -z "${KNOWN_WINDOWS[$WINDOW_ID]:-}" ]]; then
                    echo "New window detected: $INDEX ($NAME - $WINDOW_ID). Creating dedicated tab..."
		    kitty_create_tab "$INDEX" "$NAME" "$RUNNER" "$REMOTE" "$SESSION" "$WINDOW_ID"
                    KNOWN_WINDOWS[$WINDOW_ID]=1
                    sleep 0.8  # Allow tab to initialize fully

                    # ONLY execute movement/sorting calculation right after launching a new tab
                    kitty_sort_tab $KITTY_SOCKET

                fi
            done


            for WID in "${!KNOWN_WINDOWS[@]}"; do
                if [[ -z "${CURRENT_ACTIVE_IDS[$WID]:-}" ]]; then
                    unset "KNOWN_WINDOWS[$WID]"
                fi
            done
        fi

        sleep "$POLL_INTERVAL"
    done
}

main "$@"
