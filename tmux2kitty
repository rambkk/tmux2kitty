set -u
umask 0077

SESSION=""
RUNTIME_DIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/tmux-kitty"
DESTINATION_HOST=""
LOCAL=""
WORKDIR=""
CONNECTION_DIR=""


# Kitty control socket
KITTY_SOCKET=""

# SSH multiplexing socket
SSH_CONTROL="$HOME/.ssh/control-%C"
SSH_CONTROL_PATH=""
SSH_CONTROL_ID=""

RECONNECT_DELAY=2
POLL_INTERVAL=1

# ============================================================
# SSH OPTIONS
# ============================================================

SSH_OPTS=(
    -o ControlMaster=auto
    -o ControlPath="$SSH_CONTROL"
    -o ControlPersist=10m
    -o ServerAliveInterval=10
    -o ServerAliveCountMax=3
    -o ConnectTimeout=10
)

SESSION_REGEX='^[A-Za-z0-9_.-]{1,32}$'
TMUX_WINID_REGEX='^@?[0-9]{1,6}$'
TMUX_INDEX_REGEX='^[0-9]{1,6}$'
TMUX_WINNAME_REGEX='^[[:print:]]{0,32}$'



# ============================================================
# COMMAND LINE ARGUMENTS
# ============================================================

usage() {
    echo "Usage: $0 <remote|local> [-t 'session name']"
    echo
    echo "Arguments:"
    echo "  <remote|local>       Remote SSH host, or 'local'"
    echo "  -t 'session name'    Optional tmux session name"
    echo
    echo "Examples:"
    echo "  $0 user@server"
    echo "  $0 user@server -t mysession"
    echo "  $0 local"
    echo "  $0 local -t mysession"
}


check_param()
{
# Exactly 1 argument: remote/local, prompt for session
# Exactly 3 arguments: remote/local -t session, don't prompt

local -n destination_host="$1"
local -n session="$2"

shift 2

if [[ $# -eq 1 ]]; then
    destination_host="$1"
    session=""
elif [[ $# -eq 3 ]]; then

    if [[ "$2" != "-t" || -z "$3" ]]; then
        usage
        exit 1
    fi

    destination_host="$1"
    session="$3"
    if [[ ! "$session" =~ $SESSION_REGEX ]]; then
	echo "Invalid session name. Allowed characters: letters, numbers, underscores, dots, and hyphens. Maximum length is 32 bytes." >&2
	exit 1
    fi

else
    usage
    exit 1
fi
}

validate_destination_host()
{
    local destination_host="$1"

    [[ -n "$destination_host" ]] ||
        do_exit 1 "missing SSH destination"

    [[ "$destination_host" != -* ]] ||
        do_exit 1 "SSH destination cannot begin with '-'"

    [[ "$destination_host" == *[![:print:]]* ]] &&
        do_exit 1 "SSH destination contains non-printable characters"
}

get_control_id()
{
local destination_host="$1"
local -n ssh_control_path="$2"
local -n ssh_control_id="$3"

if [[ "${LOCAL:-0}" -eq 1 ]]; then
    ssh_control_path="local"
    ssh_control_id="local"
    return 0
fi


ssh_control_path=$(ssh "${SSH_OPTS[@]}" -G -- "$DESTINATION_HOST" |
    awk '$1 == "controlpath" { print $2; exit }') ||
    do_exit 1 "unable to resolve SSH control path"

ssh_control_id="${ssh_control_path##*/control-}"

[[ "$ssh_control_id" =~ ^[[:xdigit:]]{20,50}$ ]] ||
    do_exit 1 "unexpected SSH control identifier"

}

create_runtime_dir()
{
    local runtime_dir="$1"
    local uid owner mode

    [[ -n "$runtime_dir" ]] ||
        do_exit 1 "runtime directory is empty"

    [[ "$runtime_dir" == /* ]] ||
        do_exit 1 "runtime directory must be absolute: $runtime_dir"

    uid=$(id -u) ||
        do_exit 1 "unable to determine current UID"

    # Never accept a symlink as the runtime directory.
    [[ ! -L "$runtime_dir" ]] ||
        do_exit 1 "runtime directory is a symlink: $runtime_dir"

    mkdir -m 700 -- "$runtime_dir" 2>/dev/null

    [[ -d "$runtime_dir" ]] ||
        do_exit 1 "runtime path is not a directory: $runtime_dir"

    owner=$(stat -c '%u' -- "$runtime_dir") ||
        do_exit 1 "unable to inspect runtime directory: $runtime_dir"

    [[ "$owner" == "$uid" ]] ||
        do_exit 1 "runtime directory is not owned by current user: $runtime_dir"

    mode=$(stat -c '%a' -- "$runtime_dir") ||
        do_exit 1 "runtime directory has unsafe permissions: $runtime_dir"

    [[ "$mode" == "700" ]] ||
        do_exit 1 "runtime directory must have mode 700: $runtime_dir"
}


create_connection_dir()
{
    local connection_dir="$1"
    local marker_file
    local expected_marker="tmux-kitty-connection-v1"
    local uid owner mode marker

    [[ -n "$connection_dir" ]] ||
        do_exit 1 "connection directory is empty"

    [[ "$connection_dir" == /* ]] ||
        do_exit 1 "connection directory must be absolute: $connection_dir"

    uid=$(id -u) ||
        do_exit 1 "unable to determine current UID"

    marker_file="$connection_dir/.tmux-kitty-connection"

    # Never follow a symlink.
    [[ ! -L "$connection_dir" ]] ||
        do_exit 1 "connection directory is a symlink: $connection_dir"

    if [[ -e "$connection_dir" ]]; then
        [[ -d "$connection_dir" ]] ||
            do_exit 1 "connection path is not a directory: $connection_dir"

        owner=$(stat -c '%u' -- "$connection_dir") ||
            do_exit 1 "unable to inspect connection directory: $connection_dir"

        [[ "$owner" == "$uid" ]] ||
            do_exit 1 "connection directory is not owned by current user: $connection_dir"

        mode=$(stat -c '%a' -- "$connection_dir") ||
            do_exit 1 "connection directory has unsafe permissions: $connection_dir"

        [[ "$mode" == "700" ]] ||
            do_exit 1 "connection directory must have mode 700: $connection_dir"

        [[ -f "$marker_file" ]] ||
            do_exit 1 "connection directory is not a tmux-kitty directory: $connection_dir"

        marker=$(<"$marker_file") ||
            do_exit 1 "unable to read connection directory marker"

        [[ "$marker" == "$expected_marker" ]] ||
            do_exit 1 "invalid connection directory marker: $connection_dir"

        # This is our own stale state, so it is safe to reset.
        rm -rf -- "$connection_dir" ||
            do_exit 1 "failed to remove stale connection directory: $connection_dir"
    fi

    mkdir -m 700 -- "$connection_dir" ||
        do_exit 1 "failed to create connection directory: $connection_dir"

    printf '%s\n' "$expected_marker" > "$marker_file" ||
        do_exit 1 "failed to create connection directory marker"

    chmod 600 -- "$marker_file" ||
        do_exit 1 "failed to secure connection directory marker"
}






# ============================================================
# TRAP CLEANUP
# ============================================================

cleanup() {
    [[ -n "${SESSION_DIR:-}" ]] && rm -rf -- "$SESSION_DIR"
}
trap cleanup EXIT


# ============================================================
# SSH CONTROL CHANNEL FUNCTIONS
# ============================================================

ssh_master_alive()
{
    [ "${LOCAL:-0}" -eq 1 ] && return 0
    ssh "${SSH_OPTS[@]}" -O check "$DESTINATION_HOST"  >/dev/null 2>&1
}

check_ssh_socket()
{
	[ "${LOCAL:-0}" -eq 1 ] && return 0

	local ssh_host="$1"
	local socket_path=$(ssh "${SSH_OPTS[@]}" -G -- "$ssh_host" | awk '/^controlpath / {print $2}')

	# Check if the file exists AND the connection test fails
	if [ -S "$socket_path" ] && ! ssh "${SSH_OPTS[@]}" -O check -- "$ssh_host" 2>/dev/null; then
	    echo "⚠️ Stale SSH session detected! Fixing..."
	    rm -f -- "$socket_path"
	fi

}

start_ssh_master()
{
    [ "${LOCAL:-0}" -eq 1 ] && return 0

    echo "Connecting to $DESTINATION_HOST..."

    # Is there already a working master?
    if ssh_master_alive; then
        echo "SSH master already connected."
        return 0
    fi

    # There may be a stale control socket.
    check_ssh_socket "$DESTINATION_HOST"

    # No usable master: create one.
    if ssh "${SSH_OPTS[@]}" -MNf "$DESTINATION_HOST"; then
        echo "SSH master connected."
        return 0
    fi

    echo "ERROR: unable to establish SSH master."
    return 1
}

init_ssh_control()
{
    if ssh_master_alive; then
        return 0
    fi

    while ! start_ssh_master; do
        echo "Retrying SSH in ${RECONNECT_DELAY}s..."
        sleep "$RECONNECT_DELAY"
    done
}


ssh_remote_bash()
{
    local script="$1"
    shift

    if [[ "$LOCAL" -eq 1 ]]; then
        bash -s -- "$@" <<< "$script"
    else
        ssh "${SSH_OPTS[@]}" -- "$DESTINATION_HOST" bash -s -- "$@" <<< "$script"
    fi
}



# ============================================================
# SESSION SELECTION MENU
# ============================================================

tmux_all_session_list()
{
    local session_regex="$SESSION_REGEX"
    echo "=========================================="
    echo " TMUX REMOTE GUI LAUNCHER"
    echo "=========================================="

    echo "Active remote sessions on $DESTINATION_HOST:"

    mapfile -t sessions < <(
        ssh_remote_bash 'tmux list-sessions -F "#{session_name}" 2>/dev/null'
    )

    if ((${#sessions[@]} == 0)); then
        echo "  (No active tmux sessions found)"
        echo "------------------------------------------"
        return
    fi

    for s in "${sessions[@]}"; do
        [[ "$s" != *__* ]] || continue
        [[ "$s" =~ $session_regex ]] || continue

        echo "  📦 Session: $s"

        ssh_remote_bash '
          tmux list-windows \
            -t "=$1" \
            -F "     >> Index #{window_index}: #{window_name}" \
            2>/dev/null' $s
    done

    echo "------------------------------------------"
}



input_session_name()
{
    local -n session="$1"
    local base_name="tmux-kitty"
    local default_session="${base_name}"
    local input_session
    

	while true; do
	    if [[ -z "$session" ]]; then
		read -p "Enter session name to connect or create [$default_session]: " input_session
		session="${input_session:-$default_session}"
	    else
		echo "Using session: $session"
	    fi

	    if [[ "$session" =~ $SESSION_REGEX ]]; then
		break
	    fi

	    echo "Invalid session name. Allowed characters: letters, numbers, underscores, dots, and hyphens. Maximum length is 32 bytes." >&2
	    session=""
	done


}
	    
tmux_select_or_create_session()
{
	local session="$1"
	if ! ssh_remote_bash 'tmux has-session -t "=$1" >/dev/null 2>&1' $session; then
	    echo "Session '$session' does not exist. Creating it now..."
	    ssh_remote_bash 'tmux new-session -d -s "$1"' $session
	else
	    echo "Connecting to existing session: $session"
	fi
	echo
}


# ============================================================
# KITTY CONNECTION FUNCTIONS
# ============================================================

init_kitty()
{
    local kitty_socket="$KITTY_SOCKET"
    local -n ref_kitty_pid="$1"
    local tab_watcher="$2"
    rm -f -- "$kitty_socket"

    echo "Starting Kitty terminal..."
    kitty \
        -o allow_remote_control=socket-only \
        -o remember_window_size=no \
        -o initial_window_width=100c \
        -o initial_window_height=24c \
        -o scrollback_pager="less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER" \
        -o mouse_map="wheel_up ungrabbed scroll_line_up" \
        -o mouse_map="wheel_down ungrabbed scroll_line_down" \
        -o tab_title_template="{title}" \
        -o dynamic_title=yes \
        --watcher "${tab_watcher}" \
        --listen-on "unix:${kitty_socket}" &

    local kitty_pid=$!
    ref_kitty_pid=$kitty_pid

    for _ in {1..100}; do
        if [[ -S "$kitty_socket" ]]; then
            ref_kitty_pid=$kitty_pid
            return 0
        fi
        sleep 0.1
    done

    echo "ERROR: kitty socket did not appear."
    return 1
}

kitty_cmd()
{
    local kitty_socket="$KITTY_SOCKET"
    if [ -S "$KITTY_SOCKET" ]; then
       kitty @ \
           --to "unix:${kitty_socket}" \
           "$@"
    else
       do_exit 1 "Parent function was: ${FUNCNAME[1]} - Kitty socket not found: $KITTY_SOCKET - Exiting"
    fi
}

kitty_create_tab()
{
    local index="$1"
    local name="$2"
    local runner="$3"
    local remote="$4"
    local session="$5"
    local window_id="$6"

                    kitty_cmd launch \
                        --type=tab \
                        --tab-title "$index-$name" \
                        --title "$index-$name" \
                        "$runner" "$remote" "$session" "$window_id" \
                        >/dev/null

                    KNOWN_WINDOWS[$WINDOW_ID]=1

}

kitty_sync_tab_title()
{
    local window_ref="$1"
    local index="$2"
    local name="$3"
    local session="$4"

    local ref
    local clean_ref

    local tab_id
    local expected_title
    local current_title

    clean_ref="${window_ref#@}"

    
    # 1. Determine the expected title
    if [ -n "$name" ]; then
        expected_title="${index}-${name}"
    else
        expected_title="${index}"
    fi


    ref="${session}___${clean_ref}"
    
    # 2. Find the actual Kitty Tab ID by searching for the reference in the cmdline
    tab_id=$(kitty_cmd ls | jq -r --arg ref "$ref" '
      .[] |
      .tabs[].windows[] |
      select(.cmdline[] == $ref) |
      .id
    ' | head -n 1)

    # 3. If a valid Tab ID was found, check and update its title
    if [ -n "$tab_id" ]; then
        current_title=$(kitty_cmd ls | jq -r --arg id "$tab_id" '.[].tabs[] | select(.id|tostring == $id) | .title // empty')

        if [ "$current_title" != "$expected_title" ]; then
            kitty_cmd set-tab-title --match "id:$tab_id" "$expected_title"
            kitty_cmd set-window-title --match "id:$tab_id" "$expected_title"
        fi
    fi
}

switch_tab()
{
    local window_ref="$1"
    local session="$2"
    local clean_ref="${window_ref#@}"
    local tab_id

    local ref="${session}___${clean_ref}"

    tab_id=$(kitty_cmd ls | jq -r --arg ref "$ref" '
      .[] |
      .tabs[].windows[] |
      select(.cmdline[] == $ref) |
      .id
    ' | head -n 1)

    if [ -n "$tab_id" ]; then
            kitty_cmd focus-tab --match "id:$tab_id"
    fi
}

create_tab_watcher()
{
    local tab_watcher="$1"
    cat > "$tab_watcher" <<'EOF'
import os
import re
import shlex
import subprocess

from kitty.fast_data_types import swap_tabs


# ============================================================================
# Numbered tab sorting
# ============================================================================

TAB_NUMBER_RE = re.compile(r"^(\d{1,6})(?:-|$)")


def get_tab_number(tab):
    """
    Return the numeric prefix of a tab title.

    Matches:
        0
        1
        123
        1-foo
        123-something

    Does not match:
        foo
        foo-123
        123foo
    """

    match = TAB_NUMBER_RE.match(tab.effective_title)

    if not match:
        return None

    return int(match.group(1))


def sort_numbered_tabs(window):
    """
    Sort numbered tabs by their numeric prefix.

    Tabs without a numeric prefix remain in exactly the same positions.

    Example:

        ~/kitty-tmux
        2-bash
        1-bash
        foo
        10-vim
        3-shell

    becomes:

        ~/kitty-tmux
        1-bash
        2-bash
        foo
        3-shell
        10-vim

    Only positions occupied by numbered tabs are rearranged.
    """

    tab = window.tabref()

    if tab is None:
        return

    tab_manager = tab.tab_manager_ref()

    if tab_manager is None:
        return

    tabs = tab_manager.tabs

    if len(tabs) < 2:
        return

    # ------------------------------------------------------------------------
    # Find all numbered tabs.
    # ------------------------------------------------------------------------

    numbered = []

    for index, current_tab in enumerate(tabs):
        number = get_tab_number(current_tab)

        if number is not None:
            numbered.append(
                (number, index, current_tab)
            )

    if len(numbered) < 2:
        return

    # ------------------------------------------------------------------------
    # Find the positions occupied by numbered tabs.
    #
    # These positions are the only positions that are allowed to change.
    # ------------------------------------------------------------------------

    numbered_positions = [
        index
        for index, current_tab in enumerate(tabs)
        if get_tab_number(current_tab) is not None
    ]

    # ------------------------------------------------------------------------
    # Sort numerically.
    #
    # The original index is used as a secondary key so tabs with the same
    # number retain their original relative order.
    # ------------------------------------------------------------------------

    numbered.sort(key=lambda item: (item[0], item[1]))

    desired_tabs = [
        current_tab
        for _, _, current_tab in numbered
    ]

    # ------------------------------------------------------------------------
    # Already sorted?
    # ------------------------------------------------------------------------

    if all(
        tabs[position] is desired_tab
        for position, desired_tab
        in zip(numbered_positions, desired_tabs)
    ):
        return

    # ------------------------------------------------------------------------
    # Remember the active tab so sorting doesn't change what the user is
    # looking at.
    # ------------------------------------------------------------------------

    active_tab = tab_manager.active_tab

    # ------------------------------------------------------------------------
    # Reorder the numbered tabs.
    #
    # We swap tabs directly rather than using move_tab_forward/backward.
    #
    # This is important because move_tab_forward/backward would move a
    # numbered tab through unnumbered tabs. Direct swaps let us preserve
    # the exact positions of unnumbered tabs.
    # ------------------------------------------------------------------------

    for target_position, desired_tab in zip(
        numbered_positions,
        desired_tabs,
    ):
        # Refresh the list because the previous swap changed its order.
        tabs = tab_manager.tabs

        current_position = tabs.index(desired_tab)

        if current_position == target_position:
            continue

        # Update Kitty's Python-side tab ordering.
        tabs[current_position], tabs[target_position] = (
            tabs[target_position],
            tabs[current_position],
        )

        # Update Kitty's actual OS/window tab ordering.
        swap_tabs(
            tab_manager.os_window_id,
            current_position,
            target_position,
        )

    # ------------------------------------------------------------------------
    # Restore the previously active tab.
    # ------------------------------------------------------------------------

    if active_tab is not None:
        tabs = tab_manager.tabs
        active_position = tabs.index(active_tab)

        tab_manager._set_active_tab(
            active_position,
            store_in_history=False,
        )

    tab_manager.mark_tab_bar_dirty()


# ============================================================================
# Focused Kitty tab update to tmux active window
# ============================================================================

def on_focus_change(boss, window, data):
    if not data["focused"]:
        return

    # Sort numbered tabs independently from the tmux logic.
    sort_numbered_tabs(window)

    session_regex = os.getenv("TMUX2KITTY_SESSION_REGEX")
    if session_regex is None:
        raise RuntimeError("TMUX2KITTY_SESSION_REGEX environment variable is not set")

    tmux_winid_regex = os.getenv("TMUX2KITTY_TMUX_WINID_REGEX")
    if tmux_winid_regex is None:
        raise RuntimeError("TMUX2KITTY_TMUX_WINID_REGEX environment variable is not set")

    destination_host = os.getenv("TMUX2KITTY_DESTINATION_HOST")
    if destination_host is None:
        raise RuntimeError("TMUX2KITTY_DESTINATION_HOST environment variable is not set")

    ssh_control = os.getenv("TMUX2KITTY_SSH_CONTROL")
    if ssh_control is None:
        raise RuntimeError("TMUX2KITTY_SSH_CONTROL environment variable is not set")
    
    ssh_control_master = os.getenv("TMUX2KITTY_SSH_CONTROL_MASTER")
    if ssh_control_master is None:
        raise RuntimeError("TMUX2KITTY_SSH_CONTROL_MASTER environment variable is not set")
    
    ssh_control_persist = os.getenv("TMUX2KITTY_SSH_CONTROL_PERSIST")
    if ssh_control_persist is None:
        raise RuntimeError("TMUX2KITTY_SSH_CONTROL_PERSIST environment variable is not set")
    
    ssh_opts = [
        "-o", f"ControlMaster={ssh_control_master}",
        "-o", f"ControlPath={ssh_control}",
        "-o", f"ControlPersist={ssh_control_persist}",
    ]
    

    result = ""
    cmdline = window.child.cmdline

    arg = cmdline[-1]
    parts = arg.rsplit("___", 1)
    
    if len(parts) == 2:
        session_name, winid = parts
    
        if (
            re.fullmatch(session_regex, session_name)
            and re.fullmatch(tmux_winid_regex, winid)
        ):
            result = f"{session_name}:@{winid}"

    if not result:
        return

    if destination_host == "local":
        cmd = [
            "tmux",
            "select-window",
            "-t",
            result,
        ]
    else:
        cmd = [
            "ssh",
            *ssh_opts,
            destination_host,
            "tmux",
            "select-window",
            "-t",
            result,
        ]

    subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


# ============================================================================
# Sort when a tab title changes
# ============================================================================

def on_title_change(boss, window, data):
    sort_numbered_tabs(window)
EOF
}

create_runner()
{
    local runner="$1"
    cat > "$runner" <<'EOF'
#!/usr/bin/env bash
set -u

if [[ "$1" == "local" ]]; then
    LOCAL=1
else
    LOCAL=0
fi

DESTINATION_HOST="$1"
SESSION="$2"
WINDOW_ID="$3"

SSH_CONTROL="$HOME/.ssh/control-%C"
RECONNECT_DELAY=2

SSH_OPTS=(
    -o ControlMaster=auto
    -o ControlPath="$SSH_CONTROL"
    -o ControlPersist=10m
    -o ServerAliveInterval=10
    -o ServerAliveCountMax=3
    -o ConnectTimeout=10
)

do_exit()
{
        local exit_code="$1"

        shift

        echo "$@"
        exit $exit_code
}


validate_destination_host()
{
    local destination_host="$1"

    [[ -n "$destination_host" ]] ||
        do_exit 1 "missing SSH destination"

    [[ "$destination_host" != -* ]] ||
        do_exit 1 "SSH destination cannot begin with '-'"

    [[ "$destination_host" == *[![:print:]]* ]] &&
        do_exit 1 "SSH destination contains non-printable characters"
}

ssh_remote_bash()
{
    local script="$1"
    shift

    if [[ "$LOCAL" -eq 1 ]]; then
        bash -s -- "$@" <<< "$script"
    else
        ssh "${SSH_OPTS[@]}" -- "$DESTINATION_HOST" bash -s -- "$@" <<< "$script"
    fi
}
ssh_interactive_tmux()
{
    local tab_session="$1"

    if [[ "$LOCAL" -eq 1 ]]; then
        exec env TERM=xterm-256color \
            tmux attach-session -t "$tab_session"
    else
        exec ssh "${SSH_OPTS[@]}" -t -- "$DESTINATION_HOST" \
            env TERM=xterm-256color tmux attach-session -t "$tab_session"
    fi
}

ssh_master_alive()
{
[ "${LOCAL:-0}" -eq 1 ] && return 0
    ssh "${SSH_OPTS[@]}" -O check -- "$DESTINATION_HOST" >/dev/null 2>&1
}

SAFE_WID="${WINDOW_ID//@/_}"
TAB_SESSION="${SESSION}__${SAFE_WID}"

cleanup_tab() {
    if [[ -n "${KITTY_WINDOW_ID:-}" && -n "${KITTY_SOCKET:-}" ]]; then
        kitty @ --to "unix:${KITTY_SOCKET}" close-tab --match "id:${KITTY_WINDOW_ID}" 2>/dev/null || true
    fi
}
trap cleanup_tab EXIT

validate_destination_host "$DESTINATION_HOST"
while true; do
    while ! ssh_master_alive; do
        sleep "$RECONNECT_DELAY"
    done

    # Ensure an isolated session exists, link the window, disable mouse/alternate-screen, and set term-overrides
ssh_remote_bash '
	tab_session="$1"
	session="$2"
	window_id="$3"

	if ! tmux has-session -t "=$tab_session" 2>/dev/null; then
	    tmux new-session -d -s "$tab_session"
	    tmux link-window \
		-s "$session:$window_id" \
		-t "$tab_session:" \
		2>/dev/null || true

	    tmux kill-window \
		-t "$tab_session:0" \
		2>/dev/null || true

	    tmux set-option -t "$tab_session" mouse off
	    tmux set-option -t "$tab_session" status off
	    tmux set-option -t "$tab_session" default-terminal "xterm-256color"
	    tmux set-option -ga terminal-overrides ",xterm*:smcup@:rmcup@"
	fi
        ' "$TAB_SESSION" "$SESSION" "$WINDOW_ID" >/dev/null 2>&1

ssh_interactive_tmux "$TAB_SESSION"
RET=$?

if [[ $RET -eq 0 ]]; then
    exit 0
fi

    sleep "$RECONNECT_DELAY"
done
EOF

    chmod +x "$runner"
}

tmux_purge_stale()
{
	local session="$1"

	ssh_remote_bash '
	set -u
	session="$1"

	tmux list-sessions -F "#{session_name}" 2>/dev/null |
	while IFS= read -r s; do
	    [[ "$s" == "${session}__"* ]] || continue
	    tmux kill-session -t "$s"
	done
        ' $session
}

tmux_window_to_session()
{
        local session="$1"
        local session_regex_enc=$(printf '%s' "$SESSION_REGEX"  | base64 -w0)
        local tmux_winid_regex_enc=$(printf '%s' "$TMUX_WINID_REGEX" | base64 -w0)
	ssh_remote_bash '
          session="$1"
          session_regex=$(printf "%s" "$2" | base64 -d)
          tmux_winid_regex=$(printf "%s" "$3" | base64 -d)
          
          while IFS= read -r s; do
              [[ "$s" == "${session}__"* ]] || continue
              [[ "$s" =~ $session_regex ]] || continue
          
              while IFS= read -r wid; do
                  [[ "$wid" =~ $tmux_winid_regex ]] || continue
          
                  if ! tmux list-windows \
                      -t "=$session" \
                      -F "#{window_id}" 2>/dev/null |
                      grep -q -F -- "$wid"; then
                      tmux move-window \
                          -s "$s:$wid" \
                          -t "=$session:" \
                          2>/dev/null || true
                  fi
              done < <(tmux list-windows -t "$s" -F "#{window_id}" 2>/dev/null)
          done < <(tmux list-sessions -F "#{session_name}" 2>/dev/null)
          ' "$session" "$session_regex_enc" "$tmux_winid_regex_enc"

}

tmux_window_list() {
	local session="$1"
	ssh_remote_bash '
		tmux list-windows -t "=$1" -F "#{window_id}|#{window_index}|#{window_name}" 2>/dev/null' $session
}

tmux_get_active_winid() {
	local session="$1"
	ssh_remote_bash 'tmux display-message -t "$1" -p "#{window_id}" 2>/dev/null' $session
}


do_exit()
{
	local exit_code="$1"
	
	shift

	echo "$@"
	exit $exit_code
}
        
# ============================================================
# MAIN EXECUTION FLOW
# ============================================================

main()
{
    #
    # Before starting, create runtime directory
    # $DESTINATION_HOST and $SESSION update by reference
    #
    check_param "DESTINATION_HOST" "SESSION" "$@"
    # Check validity of DESTINATION_HOST
    validate_destination_host "$DESTINATION_HOST"

    #set proper LOCAL value
    [[ "$DESTINATION_HOST" == "local" ]] && LOCAL=1 || LOCAL=0

    create_runtime_dir "$RUNTIME_DIR"
    get_control_id "$DESTINATION_HOST" "SSH_CONTROL_PATH" "SSH_CONTROL_ID"

    # Check local or remote session
    if [[ "$DESTINATION_HOST" == "local" ]]; then
         LOCAL=1
    else
         LOCAL=0
    fi

    # export variables to be used from the watcher script
    export TMUX2KITTY_DESTINATION_HOST=$DESTINATION_HOST
    export TMUX2KITTY_SSH_CONTROL="$SSH_CONTROL"
    export TMUX2KITTY_SSH_CONTROL_MASTER="auto"
    export TMUX2KITTY_SSH_CONTROL_PERSIST="10m"
    export TMUX2KITTY_SESSION_REGEX="$SESSION_REGEX"
    export TMUX2KITTY_TMUX_WINID_REGEX="$TMUX_WINID_REGEX"

    # Initialize SSH multiplexing control channel
    init_ssh_control

    # Present startup session menu
    tmux_all_session_list "$DESTINATION_HOST"

    # if command line do not have SESSION then ask
    # $SESSION update by reference
    if [[ -z "$SESSION" ]]; then
         input_session_name "SESSION"
    fi

    CONNECTION_DIR="$RUNTIME_DIR/$SSH_CONTROL_ID"
    create_connection_dir "$CONNECTION_DIR"
    SESSION_DIR="$CONNECTION_DIR/$SESSION"
    WORKDIR="$SESSION_DIR/work"
    KITTY_SOCKET="$SESSION_DIR/kitty.sock"
	mkdir -m 700 -- "$SESSION_DIR" ||
	    do_exit 1 "failed to create session directory"

	mkdir -m 700 -- "$WORKDIR" ||
	    do_exit 1 "failed to create work directory"


    tmux_select_or_create_session "$SESSION"

    # Purge stale remote tab sessions from previous runs for this session safely
    echo "Purging stale remote tab sessions..."
    tmux_purge_stale "$SESSION"

    # Create tab runner script
    RUNNER="$WORKDIR/remote-tmux-tab.sh"
    create_runner "$RUNNER"

    # Create tab watcher script for updating active window to tmux
    TAB_WATCHER="$WORKDIR/tabwatcher.py"
    create_tab_watcher "$TAB_WATCHER"

    # Initialize local Kitty terminal instance
    # $KITTY_PID update by reference
    init_kitty "KITTY_PID" $TAB_WATCHER || exit 1

    declare -A KNOWN_WINDOWS

    echo
    echo "=========================================="
    echo " Remote tmux GUI started (Native Scrolling)"
    echo "=========================================="
    echo "Remote : $DESTINATION_HOST"
    echo "Session: $SESSION"
    echo "Kitty  : $KITTY_PID"
    echo

    local active_winid
    active_winid=$(tmux_get_active_winid "$SESSION")
	
    local first_run
    first_run=1

    local created_new_tab
    created_new_tab=0

    # Continuous monitoring loop
    while true; do
        if [ ! -S "$KITTY_SOCKET" ]; then
            do_exit 0 "Kitty socket not found, exiting normally..." 
        fi
        # Create a new session for each window
        tmux_window_to_session "$SESSION"

        if mapfile -t WINDOWS < <(tmux_window_list "$SESSION"); then
            declare -A CURRENT_ACTIVE_IDS
            for ENTRY in "${WINDOWS[@]}"; do
                IFS='|' read -r WINDOW_ID INDEX NAME <<< "$ENTRY"

		[[ "$WINDOW_ID" =~ $TMUX_WINID_REGEX   ]] || continue
		[[ "$INDEX"     =~ $TMUX_INDEX_REGEX   ]] || continue

                # Remove control characters from the strings eg. literal \r \n etc.
                printf -v NAME '%b' "$NAME"
                NAME="${NAME//[$'\u200b\u200c\u200d\u202e\u200f\u202a\u202b\u202c']}"
                NAME="${NAME//[[:cntrl:]]}"
                NAME="${NAME//|}"
		[[ "$NAME"      =~ $TMUX_WINNAME_REGEX ]] || continue
                CURRENT_ACTIVE_IDS[$WINDOW_ID]=1

                kitty_sync_tab_title "$WINDOW_ID" "$INDEX" "$NAME" "$SESSION"

                if [[ -z "${KNOWN_WINDOWS[$WINDOW_ID]:-}" ]]; then
                    echo "New window detected: $INDEX ($NAME - $WINDOW_ID). Creating dedicated tab..."
		    kitty_create_tab "$INDEX" "$NAME" "$RUNNER" "$DESTINATION_HOST" "$SESSION" "$WINDOW_ID"
                    KNOWN_WINDOWS[$WINDOW_ID]=1
                    created_new_tab=1
                fi
            done

            if [ "$created_new_tab" -eq 1 ]; then
                created_new_tab=0
            fi

            if [ "$first_run" -eq 1 ]; then
                if [ -n "$active_winid" ]; then
                    # Wait for tabs to be initialized before switching to tmux active window
                    sleep 1
                    echo "$active_winid" "$SESSION"
                fi
                first_run=0
            fi


            for WID in "${!KNOWN_WINDOWS[@]}"; do
                if [[ -z "${CURRENT_ACTIVE_IDS[$WID]:-}" ]]; then
                    unset "KNOWN_WINDOWS[$WID]"
                fi
            done
        fi

        sleep "$POLL_INTERVAL"
    done
}

main "$@"
